# ---------------------------------------------------------------------------
# VibeShield AI - environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="VibeShield AI"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# SQLite (local dev default). For PostgreSQL use e.g.:
#   DATABASE_URL=postgresql+psycopg://vibeshield:vibeshield@postgres:5432/vibeshield
DATABASE_URL=sqlite:///./vibeshield.db

# --- Auth / RBAC ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap admin (created on first run if no users exist)
FIRST_ADMIN_NAME=Security Analyst
FIRST_ADMIN_EMAIL=admin@vibeshield.local
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_ROLE=admin

# --- Scanning safety controls ---
SCAN_REQUEST_TIMEOUT=15            # seconds per outbound request
SCAN_TOTAL_TIMEOUT=900            # seconds per full scan
SCAN_MAX_REQUESTS_PER_TARGET=250  # hard cap on outbound requests per scan
SCAN_REQUESTS_PER_SECOND=4        # per-target rate limit
SCAN_ALLOW_PRIVATE_TARGETS=true   # allow scanning localhost / lab targets
SCAN_MAX_CONCURRENCY=4            # global concurrent scans

# --- AI analysis layer (Phase 7) ---
# AI is OFF by default; the core application is fully functional without it.
# Family: "offline" (no AI) | "openai_compat" (OpenRouter & other
# OpenAI-compatible chat-completions endpoints) | "glm" (GLM-family models
# served over an OpenAI-compatible transport).
AI_PROVIDER_FAMILY=offline
AI_MODEL=                            # e.g. glm-4-flash, glm-5, openrouter model id
AI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1   # endpoint used by the provider transport
AI_PROVIDER_AUTH_TYPE=bearer
AI_PROVIDER_AUTH_KEY_ENV=AI_API_KEY  # env var that holds the provider key
AI_API_KEY=
AI_MAX_FINDINGS_TO_EXPLAIN=40
#
# Phase 7 note: the coding extension's chat model (e.g. GLM-5.3 Flash inside
# VS Code) is NOT a runtime provider for VibeShield AI and exposes no usable
# API endpoint or credential. To enable AI explanations, point the family at
# a real endpoint and supply your own key via AI_API_KEY.
#
# Legacy alias kept for backward compatibility:
AI_PROVIDER=offline

# --- VirusTotal threat intelligence (third-party; optional) -----------------
# Obtain a free key at https://www.virustotal.com/ (Sign up -> API key).
# Server-side only: this key is NEVER exposed to the frontend or logs.
# Leave empty to disable the VirusTotal panel (it will report "not configured").
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT=30                      # seconds per VirusTotal HTTP request
VIRUSTOTAL_MAX_SUBMITS_PER_MINUTE=4        # app-side submission throttle (public API ~4/min)
VIRUSTOTAL_MAX_URL_LENGTH=2048

# --- Optional external tools (auto-detected; disabled when not on PATH) ---
ENABLE_EXTERNAL_TOOLS=true
ZAP_API_URL=
ZAP_API_KEY=
NUCLEI_PATH=nuclei
NMAP_PATH=nmap
SEMGREP_PATH=semgrep

# --- Phase 4: dependency audit + static source analysis ---
# Space-separated absolute directories the user is explicitly authorized to scan.
# Leave empty to disable project scanning entirely.
AUTHORIZED_PROJECT_ROOTS=
NPM_COMMAND=npm
PIP_AUDIT_COMMAND=pip-audit
TOOL_EXECUTION_TIMEOUT=180
DEPENDENCY_SCAN_TOOL_TIMEOUT=180
SEMGREP_TIMEOUT=300
ZAP_SAFE_MODE=true
ZAP_SCAN_MAX_DURATION=1800
